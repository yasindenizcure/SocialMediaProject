@model LoginViewModel
<div class="container d-flex justify-content-center align-items-center" style="height: 100vh;">
    <div class="card p-4 shadow-sm" style="width: 350px; border-radius: 10px;">
        <h2 class="text-center mb-4" style="font-family: 'Instagram Sans', sans-serif;">SocialMedia</h2>
        <form asp-action="Login" method="post">
            <input asp-for="Email" class="form-control mb-2" placeholder="Email Adresi" />
            <input asp-for="Password" type="password" class="form-control mb-3" placeholder="Şifre" />
            <button type="submit" class="btn btn-primary w-100 mb-2">Giriş Yap</button>
        </form>
        @if (ViewBag.Error != null)
        {
            <p class="text-danger text-center">@ViewBag.Error</p>
        }
    </div>
</div>